{
  "name": "agentoffice",
  "version": "0.1.0",
  "description": "A live pixel-art office for your coding agents. Claude Code, Command Code and Codex sessions become little workers at desks.",
  "type": "module",
  "bin": {
    "agentoffice": "dist/cli.js",
    "agent-office": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dist/cli.js --demo",
    "test": "node scripts/build.mjs && node --test test/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "command-code",
    "codex",
    "ai-agents",
    "pixel-art",
    "visualizer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bas3line/agent-office.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
